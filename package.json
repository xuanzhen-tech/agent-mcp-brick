{
  "name": "@xuanzhen-tech/agent-mcp-brick",
  "version": "0.1.3",
  "description": "通用 MCP 服务注册、渐进式发现与 AgentTool Provider 能力积木。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanzhen-tech/agent-mcp-brick.git"
  },
  "homepage": "https://github.com/xuanzhen-tech/agent-mcp-brick#readme",
  "bugs": {
    "url": "https://github.com/xuanzhen-tech/agent-mcp-brick/issues"
  },
  "exports": "./src/index.mjs",
  "files": [
    "src/index.mjs",
    "src/brick-definition.mjs",
    "src/main",
    "docs"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
