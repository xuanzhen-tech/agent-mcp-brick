    "smoke:contract": "node src/scripts/smoke-contract.mjs",
    "smoke:mcp": "node src/scripts/smoke-mcp.mjs",
    "smoke:integration": "node scripts/smoke-agent-integration.mjs",
    "verify": "node src/scripts/verify.mjs"
  },
